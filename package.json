{
  "name": "okf-studio",
  "version": "1.6.1",
  "description": "Visualizador e editor de bibliotecas no formato Open Knowledge Format (OKF v0.1).",
  "main": "main.js",
  "author": "OKF Studio",
  "license": "MIT",
  "scripts": {
    "build:editor": "esbuild src/editor/index.js --bundle --format=iife --global-name=OKFEditor --outfile=renderer/vendor/editor.bundle.js --legal-comments=none",
    "build:convert": "esbuild src/convert/index.js --bundle --format=iife --global-name=OKFConvert --outfile=renderer/vendor/convert.bundle.js --legal-comments=none && node scripts/copy-convert-assets.mjs",
    "prestart": "npm run build:editor && npm run build:convert",
    "start": "electron .",
    "test": "node test-okf.js && node test-tipo-pasta.js && node test-convert.js && node test-watcher-error.js && node test-recents.js && node test-grouping.js && node test-delta.js && node test-ops.js",
    "test:ui": "electron test-renderer.js",
    "test:watch": "node test-watcher.js",
    "test:watcher-err": "node test-watcher-error.js",
    "test:git": "node test-git.js",
    "test:auto": "node test-auto.js",
    "test:templates": "node test-templates.js",
    "test:pdf": "electron test-pdf-export.js",
    "test:convert-ui": "electron test-convert-ui.js",
    "diag:pdf": "node tools/pdf2md-cli.mjs",
    "make:icon": "electron tools/make-icon.js",
    "check:files": "node scripts/check-package-files.mjs",
    "dist": "npm run check:files && npm run build:editor && npm run build:convert && electron-builder --win --x64",
    "dist:portable": "npm run check:files && npm run build:editor && npm run build:convert && electron-builder --win portable --x64",
    "release:dry": "node scripts/publish-release.mjs --dry-run",
    "publish": "npm run dist && node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@milkdown/core": "^7.21.2",
    "@milkdown/ctx": "^7.21.2",
    "@milkdown/plugin-clipboard": "^7.21.2",
    "@milkdown/plugin-history": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/plugin-slash": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/preset-gfm": "^7.21.2",
    "@milkdown/prose": "^7.21.2",
    "@milkdown/utils": "^7.21.2",
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.11",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.okfstudio.app",
    "productName": "OKF Studio",
    "asarUnpack": [
      "renderer/vendor/pdf.worker.min.mjs",
      "renderer/vendor/tesseract-worker.min.js",
      "renderer/vendor/tesseract-core.wasm",
      "renderer/vendor/tesseract-core.wasm.js",
      "renderer/vendor/tessdata/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "watcher.js",
      "git.js",
      "templates.js",
      "recents.js",
      "convert-pdf.js",
      "src/convert/**/*",
      "renderer/**/*",
      "renderer/vendor/**/*",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "sample-library",
        "to": "sample-library"
      },
      {
        "from": "tools/okf-template",
        "to": "okf-template"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OKF Studio",
      "artifactName": "OKF-Studio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "OKF-Studio-Portable-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ale-arc",
        "repo": "okf-studio"
      }
    ]
  }
}
